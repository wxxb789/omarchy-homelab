#!/bin/bash
# Switch this machine between Laptop mode and HomeLab mode.
#
#   Laptop   Closing the lid locks the session and logind suspends as usual.
#   HomeLab  Closing the lid blanks the internal display, but a logind inhibitor
#            keeps the machine running. Opening the lid brings the display and
#            keyboard back as usual. Nothing is disabled.

set -u

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/homelab"
mode_flag="$state_dir/enabled"
blanked_flag="$state_dir/lid-blanked"
deadline_file="$state_dir/deadline"
lock_file="$state_dir/lock"
inhibit_unit="homelab-inhibit.service"
lid_unit="homelab-lid.service"
deadline_unit="homelab-deadline.service"

deadline_epoch=""
deadline_label=""

power_supply_path="${HOMELAB_POWER_SUPPLY_PATH:-/sys/class/power_supply}"
thermal_path="${HOMELAB_THERMAL_PATH:-/sys/class/thermal}"

if (( ${EUID:-$(id -u)} == 0 )); then
  echo "homelab: run this as your desktop user, not with sudo or as root." >&2
  exit 1
fi

if ! mkdir -p "$state_dir"; then
  echo "homelab: could not create $state_dir." >&2
  exit 1
fi

lid_closed() {
  timeout 3 omarchy-hw-laptop-closed >/dev/null 2>&1
}

ac_present() {
  timeout 3 omarchy-power-present >/dev/null 2>&1
}

battery_percent() {
  local supply value

  for supply in "$power_supply_path"/BAT*; do
    [[ -r $supply/capacity ]] || continue
    value=$(<"$supply/capacity")
    [[ $value =~ ^[0-9]+$ ]] || continue
    printf '%s\n' "$value"
    return 0
  done
  return 1
}

battery_status() {
  local supply value

  for supply in "$power_supply_path"/BAT*; do
    [[ -r $supply/status ]] || continue
    value=$(<"$supply/status")
    [[ -n $value ]] || continue
    printf '%s\n' "$value"
    return 0
  done
  return 1
}

temperature_c() {
  local zone value max=0

  for zone in "$thermal_path"/thermal_zone*; do
    [[ -r $zone/temp ]] || continue
    value=$(<"$zone/temp")
    [[ $value =~ ^[0-9]+$ ]] || continue
    value=$((value / 1000))
    (( value > max )) && max=$value
  done

  (( max > 0 )) || return 1
  printf '%s\n' "$max"
}

is_laptop() {
  command -v omarchy-hw-laptop >/dev/null 2>&1 && omarchy-hw-laptop >/dev/null 2>&1
}

require_laptop() {
  if ! command -v omarchy-hw-laptop >/dev/null 2>&1; then
    echo "homelab: omarchy-hw-laptop not found. This expects an Omarchy laptop." >&2
    exit 1
  fi
  if ! is_laptop; then
    echo "homelab: no laptop lid detected. HomeLab mode is for laptops." >&2
    exit 1
  fi
}

mode_name() {
  if [[ -f $mode_flag ]]; then echo "HomeLab"; else echo "Laptop"; fi
}

notify() {
  if [[ -n ${WAYLAND_DISPLAY:-} ]] && command -v notify-send >/dev/null 2>&1; then
    timeout 2 notify-send -a "HomeLab" -i "computer" "$1" "$2" >/dev/null 2>&1 || true
  fi
}

sc() {
  timeout 20 systemctl --user "$@"
}

inhibitor_held() {
  local pid

  pid=$(timeout 2 systemctl --user show -p MainPID --value "$inhibit_unit" 2>/dev/null || true)
  [[ $pid =~ ^[1-9][0-9]*$ ]] || return 1

  if timeout 2 systemd-inhibit --list --json=short --no-pager 2>/dev/null |
    jq -e --argjson pid "$pid" \
      'any(.[]; .pid == $pid and ((.what | split(":")) | index("handle-lid-switch")))' >/dev/null 2>&1; then
    return 0
  fi

  # Older systemd without --json: match the distinctive who string.
  timeout 2 systemd-inhibit --list --no-pager 2>/dev/null |
    grep -q '^HomeLab[[:space:]]'
}

duration_seconds() {
  local value="$1" total=0 number unit

  [[ $value =~ ^([0-9]+[smhd])+$ ]] || return 1
  while [[ $value =~ ^([0-9]+)([smhd])(.*)$ ]]; do
    number=$((10#${BASH_REMATCH[1]}))
    unit=${BASH_REMATCH[2]}
    value=${BASH_REMATCH[3]}
    case $unit in
      s) total=$((total + number)) ;;
      m) total=$((total + number * 60)) ;;
      h) total=$((total + number * 3600)) ;;
      d) total=$((total + number * 86400)) ;;
    esac
  done
  (( total > 0 )) || return 1
  printf '%s\n' "$total"
}

parse_deadline_args() {
  local arg value now

  deadline_epoch=""
  deadline_label=""

  while (( $# )); do
    case $1 in
      --for)
        (( $# >= 2 )) || {
          echo "homelab: --for needs a duration (for example 2h or 90m)." >&2
          return 1
        }
        [[ -z $deadline_epoch ]] || {
          echo "homelab: use only one of --for or --until." >&2
          return 1
        }
        value=$(duration_seconds "$2") || {
          echo "homelab: invalid --for duration: $2" >&2
          return 1
        }
        now=$(date +%s)
        deadline_epoch=$((now + value))
        shift 2
        ;;
      --until)
        (( $# >= 2 )) || {
          echo "homelab: --until needs a time (for example 23:00)." >&2
          return 1
        }
        [[ -z $deadline_epoch ]] || {
          echo "homelab: use only one of --for or --until." >&2
          return 1
        }
        [[ $2 =~ ^([01]?[0-9]|2[0-3]):[0-5][0-9]$ ]] || {
          echo "homelab: invalid --until time: $2 (expected HH:MM)" >&2
          return 1
        }
        now=$(date +%s)
        deadline_epoch=$(date -d "today $2" +%s 2>/dev/null) || {
          echo "homelab: could not parse --until time: $2" >&2
          return 1
        }
        if (( deadline_epoch <= now )); then
          deadline_epoch=$(date -d "tomorrow $2" +%s 2>/dev/null) || {
            echo "homelab: could not parse --until time: $2" >&2
            return 1
          }
        fi
        shift 2
        ;;
      *)
        echo "homelab: unknown option: $1" >&2
        return 1
        ;;
    esac
  done

  if [[ -n $deadline_epoch ]]; then
    deadline_label=$(date -d "@$deadline_epoch" '+%Y-%m-%d %H:%M')
  fi
  return 0
}

format_remaining() {
  local seconds="$1"

  if (( seconds >= 3600 )); then
    printf '%dh %dm' "$((seconds / 3600))" "$(((seconds % 3600) / 60))"
  elif (( seconds >= 60 )); then
    printf '%dm' "$((seconds / 60))"
  else
    printf '%ds' "$seconds"
  fi
}

write_deadline_file() {
  [[ -n $deadline_epoch ]] || return 1
  if ! printf '%s\n' "$deadline_epoch" >"$deadline_file"; then
    echo "warning: could not write $deadline_file." >&2
    return 1
  fi
}

clear_deadline_file() {
  rm -f "$deadline_file"
}

stop_deadline_service() {
  [[ ${HOMELAB_FROM_DEADLINE:-0} == 1 ]] && return 0
  if ! sc stop "$deadline_unit" >/dev/null 2>&1; then
    echo "warning: could not stop $deadline_unit." >&2
  fi
}

start_deadline_service() {
  if ! sc restart "$deadline_unit" >/dev/null 2>&1; then
    echo "warning: could not start the deadline timer; HomeLab mode stays on without a deadline." >&2
    return 1
  fi
}

hypr() {
  local sig

  if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] &&
    HYPRLAND_INSTANCE_SIGNATURE=$HYPRLAND_INSTANCE_SIGNATURE timeout 2 hyprctl "$@" 2>/dev/null; then
    return 0
  fi

  for sig in "${XDG_RUNTIME_DIR:-/run/user/$UID}"/hypr/*; do
    [[ -S $sig/.socket.sock ]] || continue
    HYPRLAND_INSTANCE_SIGNATURE=${sig##*/} timeout 2 hyprctl "$@" 2>/dev/null && return 0
  done

  return 1
}

valid_monitor() {
  [[ $1 =~ ^[A-Za-z0-9._-]+$ ]]
}

take_lock() {
  if ! command -v flock >/dev/null 2>&1; then
    echo "warning: flock not found; mode changes are not serialized." >&2
    return 0
  fi

  if ! exec 9>"$lock_file"; then
    echo "homelab: could not open $lock_file for locking." >&2
    exit 1
  fi
  if ! flock -n 9; then
    echo "homelab: another mode change is already running." >&2
    exit 1
  fi
}

start_watcher() {
  if ! sc start "$lid_unit" >/dev/null 2>&1; then
    return 1
  fi
  sc is-active --quiet "$lid_unit"
}

restore_panel() {
  [[ -f $blanked_flag ]] || return 0

  local watcher
  watcher=$(command -v homelab-lid-watch 2>/dev/null || true)
  if [[ -z $watcher ]]; then
    watcher="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/homelab-lid-watch"
  fi

  if [[ -x $watcher ]]; then
    "$watcher" --restore
    return $?
  fi
  return 1
}

announce_on() {
  local suffix="" battery temperature
  [[ -n $deadline_label ]] && suffix=" until $deadline_label"

  if command -v omarchy-power-present >/dev/null 2>&1 && ! ac_present; then
    echo "warning: no AC power; a closed laptop will drain its battery." >&2
    if [[ -z $deadline_epoch ]]; then
      echo "         Use 'homelab on --for 2h' to make the hold expire." >&2
    fi
  fi

  battery=$(battery_percent || true)
  if [[ $battery =~ ^[0-9]+$ ]] && (( 10#$battery <= 20 )); then
    echo "warning: battery is at ${battery}%; a closed laptop will drain it." >&2
  fi

  temperature=$(temperature_c || true)
  if [[ $temperature =~ ^[0-9]+$ ]] && (( 10#$temperature >= 90 )); then
    echo "warning: CPU temperature is ${temperature}C; check ventilation." >&2
  fi

  if lid_closed; then
    echo "HomeLab mode on${suffix}. The lid is closed: keeping the machine running."
    notify "HomeLab mode" "Lid closed; machine keeps running${suffix}."
  else
    echo "HomeLab mode on${suffix}. Closing the lid blanks the display but does not suspend."
    notify "HomeLab mode" "Closing the lid will no longer suspend${suffix}."
  fi
}

enable_homelab() {
  local tries=0 held=0

  if ! : >"$mode_flag"; then
    echo "HomeLab mode was not enabled: could not write $mode_flag." >&2
    return 1
  fi

  # The inhibitor is the guarantee; the lid watcher only blanks the panel.
  sc reset-failed "$inhibit_unit" >/dev/null 2>&1 || true
  if ! sc start "$inhibit_unit" >/dev/null 2>&1; then
    sc stop "$lid_unit" >/dev/null 2>&1 || true
    sc stop "$inhibit_unit" >/dev/null 2>&1 || true
    restore_panel
    rm -f "$mode_flag"
    echo "HomeLab mode was not enabled: the lid inhibitor did not start." >&2
    sc status "$inhibit_unit" --no-pager 2>&1 | tail -n 20 >&2
    notify "HomeLab mode failed" "The lid inhibitor did not start."
    return 1
  fi

  # Type=simple reports the unit started before systemd-inhibit has acquired
  # the logind lock. Wait for the inhibitor to appear in the list; a running
  # unit without a held lock is the one failure the bar cannot see.
  while (( tries < 20 )); do
    if sc is-active --quiet "$inhibit_unit" && inhibitor_held; then
      held=1
      break
    fi
    tries=$((tries + 1))
    sleep 0.1
  done

  if (( !held )); then
    sc stop "$lid_unit" >/dev/null 2>&1 || true
    sc stop "$inhibit_unit" >/dev/null 2>&1 || true
    restore_panel
    rm -f "$mode_flag"
    echo "HomeLab mode was not enabled: no lid inhibitor is held." >&2
    notify "HomeLab mode failed" "No lid inhibitor is held."
    return 1
  fi

  if ! start_watcher; then
    echo "warning: the lid inhibitor is active, but the panel watcher did not start." >&2
    echo "         The machine will keep running; the internal panel may stay on." >&2
  fi

  if ! sc enable "$inhibit_unit" "$lid_unit" "$deadline_unit" homelab-guard.timer >/dev/null 2>&1; then
    echo "warning: could not enable the units for boot; this mode will not survive a reboot." >&2
  fi
  if ! sc start homelab-guard.timer >/dev/null 2>&1; then
    echo "warning: could not start the safety guard timer." >&2
  fi

  return 0
}

disable_homelab() {
  local closed=0
  lid_closed && closed=1

  clear_deadline_file
  stop_deadline_service
  sc stop homelab-guard.timer >/dev/null 2>&1 || true
  rm -f "$mode_flag"

  # Stop the watcher first. Its ExecStopPost restores DPMS while Hyprland is
  # still alive, and its stop ordering keeps the inhibitor held until then.
  if ! sc stop "$lid_unit" >/dev/null 2>&1; then
    echo "warning: could not stop the lid watcher." >&2
  fi

  if ! restore_panel; then
    echo "warning: could not restore the internal panel; keeping HomeLab mode so it can retry." >&2
    : >"$mode_flag"
    start_watcher || true
    return 1
  fi

  if (( closed )); then
    echo "Releasing the lid inhibitor; a closed lid may suspend immediately."
  fi

  if ! sc stop "$inhibit_unit" >/dev/null 2>&1; then
    echo "warning: could not stop the lid inhibitor; restoring HomeLab mode." >&2
    : >"$mode_flag"
    start_watcher || true
    return 1
  fi

  if (( closed )); then
    echo "HomeLab mode off. If the machine stayed awake, run 'systemctl suspend' to suspend now."
  else
    echo "HomeLab mode off. Closing the lid suspends as before."
  fi

  return 0
}

cmd_on() {
  parse_deadline_args "$@" || exit 2
  take_lock
  require_laptop
  enable_homelab || exit 1

  if [[ -n $deadline_epoch ]]; then
    if write_deadline_file; then
      start_deadline_service || true
    else
      deadline_epoch=""
      deadline_label=""
    fi
  else
    clear_deadline_file
    stop_deadline_service
  fi

  announce_on
}

cmd_off() {
  (( $# == 0 )) || {
    echo "homelab: off takes no options." >&2
    exit 2
  }
  take_lock
  disable_homelab || exit 1
  notify "Laptop mode" "Lid close suspends as usual."
}

cmd_toggle() {
  (( $# == 0 )) || {
    echo "homelab: toggle takes no options." >&2
    exit 2
  }
  take_lock

  if [[ -f $mode_flag ]]; then
    disable_homelab || exit 1
    notify "Laptop mode" "Lid close suspends as usual."
  else
    clear_deadline_file
    stop_deadline_service
    require_laptop
    enable_homelab || exit 1
    announce_on
  fi
}

json_array() {
  if (( $# == 0 )); then
    printf '[]\n'
    return 0
  fi
  printf '%s\n' "$@" | jq -R . | jq -s .
}

collect_state() {
  local monitors="" user_name now

  state_flag=0
  state_inhibited=0
  state_lock_held=0
  state_watcher=0
  state_enabled=0
  state_lid_enabled=0
  state_blanked=0
  state_hypr=0
  state_lid="unknown"
  state_internal=""
  state_internal_state="unknown"
  state_dpms="unknown"
  state_linger="unknown"
  state_blanked_monitor=""
  state_ac="unknown"
  state_battery=""
  state_battery_status=""
  state_temp=""
  state_deadline_epoch=""
  state_deadline_label=""
  state_deadline_remaining=0
  state_deadline_active=0
  state_deadline_enabled=0
  state_guard_active=0
  state_guard_enabled=0
  state_mode="laptop"
  state_boot="laptop"
  state_problems=()
  state_warnings=()

  [[ -f $mode_flag ]] && state_flag=1
  sc is-active --quiet "$inhibit_unit" && state_inhibited=1
  sc is-active --quiet "$lid_unit" && state_watcher=1
  sc is-enabled --quiet "$inhibit_unit" 2>/dev/null && state_enabled=1
  sc is-enabled --quiet "$lid_unit" 2>/dev/null && state_lid_enabled=1
  [[ -f $blanked_flag ]] && state_blanked=1
  (( state_flag )) && state_mode="homelab"

  if command -v omarchy-hw-laptop-closed >/dev/null 2>&1; then
    if lid_closed; then state_lid="closed"; else state_lid="open"; fi
  fi

  if command -v omarchy-power-present >/dev/null 2>&1; then
    if ac_present; then state_ac="yes"; else state_ac="no"; fi
  fi
  state_battery=$(battery_percent || true)
  state_battery_status=$(battery_status || true)
  state_temp=$(temperature_c || true)

  if (( state_inhibited )) && inhibitor_held; then
    state_lock_held=1
  fi

  state_internal=$(timeout 3 omarchy-hyprland-monitor-laptop 2>/dev/null || true)
  valid_monitor "$state_internal" || state_internal=""

  if [[ -n $state_internal ]]; then
    monitors=$(hypr monitors all -j 2>/dev/null || true)
    if [[ -n $monitors ]] && jq -e . <<<"$monitors" >/dev/null 2>&1; then
      state_hypr=1
      state_internal_state=$(jq -r --arg m "$state_internal" \
        '.[] | select(.name == $m) | if .disabled then "disabled" else "enabled" end' \
        <<<"$monitors" | head -n 1)
      state_dpms=$(jq -r --arg m "$state_internal" \
        '.[] | select(.name == $m) | .dpmsStatus' <<<"$monitors" | head -n 1)
      [[ -n $state_internal_state && $state_internal_state != null ]] || state_internal_state="unknown"
      [[ -n $state_dpms && $state_dpms != null ]] || state_dpms="unknown"
    elif [[ -n $state_internal ]]; then
      state_warnings+=("could not query Hyprland monitor state")
    fi
  fi

  if [[ -r $blanked_flag ]]; then
    state_blanked_monitor=$(<"$blanked_flag")
    valid_monitor "$state_blanked_monitor" || state_blanked_monitor=""
  fi

  if [[ -r $deadline_file ]]; then
    state_deadline_epoch=$(<"$deadline_file")
    [[ $state_deadline_epoch =~ ^[0-9]+$ ]] || state_deadline_epoch=""
  fi
  sc is-active --quiet "$deadline_unit" && state_deadline_active=1
  sc is-enabled --quiet "$deadline_unit" 2>/dev/null && state_deadline_enabled=1
  sc is-active --quiet homelab-guard.timer && state_guard_active=1
  sc is-enabled --quiet homelab-guard.timer 2>/dev/null && state_guard_enabled=1
  if [[ -n $state_deadline_epoch ]]; then
    now=$(date +%s)
    state_deadline_remaining=$((state_deadline_epoch - now))
    (( state_deadline_remaining > 0 )) || state_deadline_remaining=0
    state_deadline_label=$(date -d "@$state_deadline_epoch" '+%Y-%m-%d %H:%M')
  fi

  user_name=$(id -un)
  state_linger=$(timeout 5 loginctl show-user "$user_name" -p Linger --value 2>/dev/null || true)
  [[ -n $state_linger ]] || state_linger="unknown"

  if (( state_flag )); then
    if (( state_enabled )); then
      if [[ $state_linger == yes ]]; then
        state_boot="homelab-persistent"
      else
        state_boot="homelab-after-login"
      fi
    else
      state_boot="homelab-not-enabled"
    fi
  fi

  if (( state_flag )) && ! (( state_inhibited )); then
    state_problems+=("mode flag is set but the lid inhibitor is not active")
  fi
  if (( state_flag )) && (( state_inhibited )) && ! (( state_lock_held )); then
    state_problems+=("the inhibitor unit is active but no handle-lid-switch lock is held")
  fi
  if ! (( state_flag )) && (( state_inhibited )); then
    state_problems+=("the lid inhibitor is active but the mode flag is absent")
  fi
  if (( state_flag )) && ! (( state_watcher )); then
    if (( state_hypr )); then
      state_problems+=("the lid watcher is not running; the panel may stay on")
    else
      state_warnings+=("the lid watcher is inactive because Hyprland is not reachable")
    fi
  fi
  if ! (( state_flag )) && (( state_watcher )); then
    state_problems+=("the lid watcher is active without HomeLab mode")
  fi
  if (( state_blanked )) && ! (( state_flag )); then
    state_problems+=("the panel is blanked without HomeLab mode")
  fi
  if (( state_flag )) && (( state_blanked )) && [[ $state_lid == open ]] && [[ $state_dpms == false ]]; then
    state_problems+=("the panel is blanked while the lid is open")
  fi
  if (( state_flag )) && [[ -n $state_deadline_epoch ]] && ! (( state_deadline_active )); then
    state_problems+=("a deadline is set but the deadline service is not running")
  fi
  if (( state_flag )) && [[ -n $state_deadline_epoch ]] && (( state_deadline_remaining == 0 )); then
    state_problems+=("the deadline has passed but HomeLab mode is still on")
  fi
  if (( state_deadline_active )) && [[ -z $state_deadline_epoch ]]; then
    state_warnings+=("the deadline service is active without a deadline file")
  fi
  if (( state_flag )) && ! (( state_guard_active )); then
    state_warnings+=("the safety guard timer is inactive")
  fi
  if (( state_flag )) && ! (( state_guard_enabled )); then
    state_warnings+=("the safety guard timer is not enabled")
  fi
  if ! (( state_flag )); then
    if [[ -n $state_deadline_epoch ]]; then
      state_warnings+=("a deadline is set while HomeLab mode is off")
    fi
    if (( state_deadline_active )); then
      state_warnings+=("the deadline service is active while HomeLab mode is off")
    fi
  fi
  if (( state_flag )) && [[ $state_ac == no ]]; then
    if [[ $state_battery =~ ^[0-9]+$ ]] && (( 10#$state_battery <= 20 )); then
      state_warnings+=("on battery at ${state_battery}%; HomeLab mode will drain it")
    fi
    if [[ -z $state_deadline_epoch ]]; then
      state_warnings+=("on battery without a deadline; prefer homelab on --for")
    fi
  fi
  if [[ $state_temp =~ ^[0-9]+$ ]] && (( 10#$state_temp >= 90 )); then
    state_warnings+=("CPU temperature is ${state_temp}C; check ventilation")
  fi

  if (( state_flag )) && ! (( state_lid_enabled )); then
    state_warnings+=("the lid watcher unit is not enabled for graphical sessions")
  fi
  if (( state_flag )) && [[ $state_linger != yes ]]; then
    state_warnings+=("boot persistence is off (linger: $state_linger)")
  fi
  if (( state_flag )) && [[ $state_lid == closed ]] && ! (( state_blanked )); then
    state_warnings+=("the lid is closed but the panel has not blanked yet")
  fi
  if (( state_flag )) && (( state_blanked )) && [[ $state_dpms == true ]]; then
    state_warnings+=("a blank marker exists but the panel is already on")
  fi
  if [[ -z $state_internal ]]; then
    state_warnings+=("internal output not detected")
  fi
  if [[ -n $state_blanked_monitor && -n $state_internal && $state_blanked_monitor != "$state_internal" ]]; then
    state_warnings+=("the blank marker names $state_blanked_monitor, but the internal output is $state_internal")
  fi
}

status_human() {
  local problem warning power

  printf 'Mode:             %s\n' "$([[ $state_mode == homelab ]] && echo HomeLab || echo Laptop)"
  printf 'Lid:              %s\n' "$state_lid"
  if (( state_inhibited )); then
    if (( state_lock_held )); then
      printf 'Lid suspend:      inhibited (lock verified)\n'
    else
      printf 'Lid suspend:      inhibited (lock NOT verified)\n'
    fi
  else
    printf 'Lid suspend:      enabled (logind suspends)\n'
  fi
  if (( state_watcher )); then
    printf 'Lid watcher:      active\n'
  else
    printf 'Lid watcher:      inactive\n'
  fi
  if [[ -z $state_internal ]]; then
    printf 'Internal display: not detected\n'
  else
    printf 'Internal display: %s (%s, DPMS %s)\n' \
      "$state_internal" "$state_internal_state" "$state_dpms"
  fi

  case "$state_ac" in
    yes) power="AC" ;;
    no) power="battery" ;;
    *) power="power unknown" ;;
  esac
  [[ -n $state_battery ]] && power+=", ${state_battery}%"
  [[ -n $state_battery_status ]] && power+=", ${state_battery_status}"
  [[ -n $state_temp ]] && power+=", ${state_temp}C"
  printf 'Power:            %s\n' "$power"

  case "$state_boot" in
    homelab-persistent) printf 'At boot:          HomeLab (persistent, linger: yes)\n' ;;
    homelab-after-login) printf 'At boot:          HomeLab after login (linger: %s)\n' "$state_linger" ;;
    homelab-not-enabled) printf 'At boot:          HomeLab flag set, but the unit is not enabled\n' ;;
    *) printf 'At boot:          Laptop (default)\n' ;;
  esac

  if (( state_blanked )); then
    if [[ -n $state_blanked_monitor ]]; then
      printf 'Panel blanked:    yes (%s)\n' "$state_blanked_monitor"
    else
      printf 'Panel blanked:    yes\n'
    fi
  fi

  if [[ -n $state_deadline_epoch ]]; then
    printf 'Deadline:         %s (%s left)\n' \
      "$state_deadline_label" "$(format_remaining "$state_deadline_remaining")"
  else
    printf 'Deadline:         none\n'
  fi

  if (( state_guard_active )); then
    printf 'Guard:            active (battery <=10%%, temp >=95C)\n'
  else
    printf 'Guard:            inactive\n'
  fi

  if (( ${#state_problems[@]} == 0 )); then
    printf 'State:            consistent\n'
  else
    printf 'State:            INCONSISTENT\n'
  fi
  for problem in "${state_problems[@]}"; do
    printf '! %s\n' "$problem"
  done
  for warning in "${state_warnings[@]}"; do
    printf '~ %s\n' "$warning"
  done
}

status_json() {
  local problems warnings
  problems=$(json_array "${state_problems[@]}")
  warnings=$(json_array "${state_warnings[@]}")

  jq -n \
    --argjson schemaVersion 1 \
    --arg mode "$state_mode" \
    --arg lid "$state_lid" \
    --argjson inhibited "$state_inhibited" \
    --argjson lockHeld "$state_lock_held" \
    --argjson watcher "$state_watcher" \
    --argjson watcherEnabled "$state_lid_enabled" \
    --argjson inhibitorEnabled "$state_enabled" \
    --arg linger "$state_linger" \
    --arg boot "$state_boot" \
    --arg internal "$state_internal" \
    --arg display "$state_internal_state" \
    --arg dpms "$state_dpms" \
    --argjson blanked "$state_blanked" \
    --argjson hyprland "$state_hypr" \
    --arg blankedMonitor "$state_blanked_monitor" \
    --arg deadlineEpoch "$state_deadline_epoch" \
    --arg deadlineLabel "$state_deadline_label" \
    --argjson deadlineRemaining "$state_deadline_remaining" \
    --argjson deadlineActive "$state_deadline_active" \
    --argjson deadlineEnabled "$state_deadline_enabled" \
    --argjson guardActive "$state_guard_active" \
    --argjson guardEnabled "$state_guard_enabled" \
    --arg ac "$state_ac" \
    --arg battery "$state_battery" \
    --arg batteryStatus "$state_battery_status" \
    --arg temperature "$state_temp" \
    --argjson problems "$problems" \
    --argjson warnings "$warnings" \
    '{
      schemaVersion: $schemaVersion,
      mode: $mode,
      lid: $lid,
      inhibitor: {
        active: ($inhibited == 1),
        lockHeld: ($lockHeld == 1)
      },
      hyprland: ($hyprland == 1),
      watcher: {
        active: ($watcher == 1),
        enabled: ($watcherEnabled == 1),
        required: ($hyprland == 1)
      },
      boot: {
        mode: $boot,
        linger: $linger,
        inhibitorEnabled: ($inhibitorEnabled == 1)
      },
      panel: {
        monitor: (if $internal == "" then null else $internal end),
        display: $display,
        dpmsOn: (if $dpms == "true" then true elif $dpms == "false" then false else null end),
        blanked: ($blanked == 1),
        blankedMonitor: (if $blankedMonitor == "" then null else $blankedMonitor end)
      },
      deadline: (if $deadlineEpoch == "" then null else {
        epoch: ($deadlineEpoch | tonumber),
        iso: $deadlineLabel,
        remainingSeconds: $deadlineRemaining,
        active: ($deadlineActive == 1),
        enabled: ($deadlineEnabled == 1)
      } end),
      guard: {
        timerActive: ($guardActive == 1),
        timerEnabled: ($guardEnabled == 1),
        batteryThreshold: 10,
        temperatureThreshold: 95
      },
      power: {
        ac: (if $ac == "yes" then true elif $ac == "no" then false else null end),
        batteryPercent: (if ($battery | test("^[0-9]+$")) then ($battery | tonumber) else null end),
        batteryStatus: (if $batteryStatus == "" then null else $batteryStatus end),
        temperatureC: (if ($temperature | test("^[0-9]+$")) then ($temperature | tonumber) else null end)
      },
      problems: $problems,
      warnings: $warnings,
      consistent: (($problems | length) == 0)
    }'
}

cmd_status() {
  local json=0 strict=0 arg

  for arg in "$@"; do
    case $arg in
      --json) json=1 ;;
      --strict) strict=1 ;;
      *)
        echo "homelab: unknown status option: $arg" >&2
        return 2
        ;;
    esac
  done

  collect_state
  if (( json )); then
    status_json
  else
    status_human
  fi

  if (( strict )) && (( ${#state_problems[@]} > 0 )); then
    return 1
  fi
  return 0
}

cmd_guard_check() {
  local ac="unknown" battery="" temperature="" threshold_battery threshold_temperature reason=""

  (( $# == 0 )) || {
    echo "homelab: guard-check takes no options." >&2
    return 2
  }

  [[ -f $mode_flag ]] || return 0

  threshold_battery=${HOMELAB_GUARD_BATTERY_PERCENT:-10}
  threshold_temperature=${HOMELAB_GUARD_TEMP_C:-95}
  [[ $threshold_battery =~ ^[0-9]+$ ]] || threshold_battery=10
  [[ $threshold_temperature =~ ^[0-9]+$ ]] || threshold_temperature=95

  if command -v omarchy-power-present >/dev/null 2>&1; then
    if ac_present; then ac="yes"; else ac="no"; fi
  fi
  battery=$(battery_percent || true)
  temperature=$(temperature_c || true)

  if [[ $ac == no && $battery =~ ^[0-9]+$ ]] &&
    (( 10#$battery <= 10#$threshold_battery )); then
    reason="battery at ${battery}% (threshold ${threshold_battery}%)"
  elif [[ $temperature =~ ^[0-9]+$ ]] &&
    (( 10#$temperature >= 10#$threshold_temperature )); then
    reason="temperature at ${temperature}C (threshold ${threshold_temperature}C)"
  fi

  [[ -n $reason ]] || return 0

  take_lock
  echo "homelab-guard: $reason; turning HomeLab mode off." >&2
  notify "HomeLab guard" "$reason; turning off."
  disable_homelab || return 1
  return 0
}

doctor_check_cmd() {
  local cmd="$1" optional="${2:-}"

  if command -v "$cmd" >/dev/null 2>&1; then
    printf '[ok]   command: %s\n' "$cmd"
  elif [[ $optional == optional ]]; then
    printf '[warn] command: %s (not installed)\n' "$cmd"
  else
    printf '[fail] command: %s (missing)\n' "$cmd"
    doctor_fail=1
  fi
}

cmd_doctor() {
  local cmd problem warning power_text

  (( $# == 0 )) || {
    echo "homelab: doctor takes no options." >&2
    return 2
  }

  doctor_fail=0
  printf '== Dependencies ==\n'
  for cmd in hyprctl jq systemctl systemd-inhibit loginctl flock timeout \
    omarchy-hw-laptop omarchy-hw-laptop-closed omarchy-hyprland-monitor-laptop; do
    doctor_check_cmd "$cmd"
  done
  doctor_check_cmd omarchy-power-present optional

  printf '\n== Hardware ==\n'
  if is_laptop; then
    printf '[ok]   laptop lid detected\n'
  else
    printf '[fail] no laptop lid detected\n'
    doctor_fail=1
  fi

  collect_state

  printf '\n== Mode ==\n'
  if (( state_flag )); then
    if (( state_inhibited )); then
      if (( state_lock_held )); then
        printf '[ok]   lid inhibitor active; handle-lid-switch lock verified\n'
      else
        printf '[fail] inhibitor unit active but no handle-lid-switch lock\n'
        doctor_fail=1
      fi
    else
      printf '[fail] mode flag set but lid inhibitor inactive\n'
      doctor_fail=1
    fi

    if (( state_watcher )); then
      printf '[ok]   lid watcher active\n'
    elif (( state_hypr )); then
      printf '[fail] lid watcher inactive while Hyprland is reachable\n'
      doctor_fail=1
    else
      printf '[warn] lid watcher inactive; Hyprland not reachable\n'
    fi

    if [[ -n $state_deadline_epoch ]]; then
      if (( state_deadline_active )); then
        printf '[ok]   deadline %s (%s left)\n' \
          "$state_deadline_label" "$(format_remaining "$state_deadline_remaining")"
      else
        printf '[fail] deadline set but deadline service inactive\n'
        doctor_fail=1
      fi
    else
      printf '[ok]   no deadline (open-ended hold)\n'
    fi
  else
    printf '[ok]   Laptop mode (inhibitor inactive)\n'
  fi

  printf '\n== Boot ==\n'
  if [[ $state_linger == yes ]]; then
    printf '[ok]   linger enabled; mode can start before login\n'
  else
    printf '[warn] linger %s; mode starts after login only\n' "$state_linger"
  fi
  if (( state_flag )) && ! (( state_enabled )); then
    printf '[warn] inhibitor unit is not enabled\n'
  fi
  if (( state_flag )) && ! (( state_lid_enabled )); then
    printf '[warn] lid watcher unit is not enabled\n'
  fi
  if (( state_flag )) && [[ -n $state_deadline_epoch ]] && ! (( state_deadline_enabled )); then
    printf '[warn] deadline unit is not enabled\n'
  fi

  printf '\n== Panel ==\n'
  if [[ -z $state_internal ]]; then
    printf '[warn] internal output not detected\n'
  else
    printf '[ok]   %s: %s, DPMS %s\n' \
      "$state_internal" "$state_internal_state" "$state_dpms"
  fi
  if (( state_blanked )); then
    if [[ -n $state_blanked_monitor ]]; then
      printf '[ok]   blank marker: %s\n' "$state_blanked_monitor"
    else
      printf '[warn] blank marker exists without a monitor name\n'
    fi
  fi

  printf '\n== Power ==\n'
  case "$state_ac" in
    yes) power_text="AC" ;;
    no) power_text="battery" ;;
    *) power_text="power unknown" ;;
  esac
  [[ -n $state_battery ]] && power_text+=", ${state_battery}%"
  [[ -n $state_battery_status ]] && power_text+=", ${state_battery_status}"
  [[ -n $state_temp ]] && power_text+=", ${state_temp}C"
  printf '[ok]   %s\n' "$power_text"

  printf '\n== Safety guard ==\n'
  if (( state_guard_active )); then
    printf '[ok]   guard timer active (battery <=10%%, temp >=95C)\n'
  else
    printf '[warn] guard timer inactive\n'
  fi
  if (( state_guard_enabled )); then
    printf '[ok]   guard timer enabled at boot\n'
  else
    printf '[warn] guard timer not enabled\n'
  fi

  printf '\n== State ==\n'
  if (( ${#state_problems[@]} == 0 )); then
    printf '[ok]   consistent\n'
  else
    for problem in "${state_problems[@]}"; do
      printf '[fail] %s\n' "$problem"
      doctor_fail=1
    done
  fi
  for warning in "${state_warnings[@]}"; do
    printf '[warn] %s\n' "$warning"
  done

  if (( doctor_fail )); then
    return 1
  fi
  return 0
}

case "${1:-status}" in
  on|homelab|server)
    shift
    cmd_on "$@"
    ;;
  off|laptop)
    shift
    cmd_off "$@"
    ;;
  toggle)
    shift
    cmd_toggle "$@"
    ;;
  status)
    shift
    cmd_status "$@"
    ;;
  doctor)
    shift
    cmd_doctor "$@"
    ;;
  guard-check)
    shift
    cmd_guard_check "$@"
    ;;
  -h|--help|help)
    cat <<'EOF'
Usage: homelab [on|off|toggle|status|doctor]

  on, homelab   HomeLab mode: keep running with the lid closed
  off, laptop   Laptop mode: suspend on lid close
  toggle        Switch between the two modes
  status        Show the current mode and lid/display state
  status --json Machine-readable state for scripts and the bar
  status --strict Exit 1 if the mode is inconsistent
  doctor        Diagnose dependencies, units, lock, panel, power, and state
EOF
    ;;
  *)
    cat <<'EOF'
Usage: homelab [on|off|toggle|status|doctor]

  on, homelab   HomeLab mode: keep running with the lid closed
  off, laptop   Laptop mode: suspend on lid close
  toggle        Switch between the two modes
  status        Show the current mode and lid/display state
  status --json Machine-readable state for scripts and the bar
  status --strict Exit 1 if the mode is inconsistent
  doctor        Diagnose dependencies, units, lock, panel, power, and state
EOF
    exit 1
    ;;
esac
