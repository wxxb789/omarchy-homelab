#!/bin/bash
# Switch this machine between Laptop mode and HomeLab mode.
#
#   Laptop   Closing the lid locks the session and logind suspends as usual.
#   HomeLab  Closing the lid blanks the internal display, but a logind inhibitor
#            keeps the machine running. Opening the lid brings the display and
#            keyboard back as usual. Nothing is disabled.

set -u

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/homelab"
mode_flag="$state_dir/enabled"
blanked_flag="$state_dir/lid-blanked"
lock_file="$state_dir/lock"
inhibit_unit="homelab-inhibit.service"
lid_unit="homelab-lid.service"

if (( ${EUID:-$(id -u)} == 0 )); then
  echo "homelab: run this as your desktop user, not with sudo or as root." >&2
  exit 1
fi

if ! mkdir -p "$state_dir"; then
  echo "homelab: could not create $state_dir." >&2
  exit 1
fi

lid_closed() {
  timeout 3 omarchy-hw-laptop-closed >/dev/null 2>&1
}

is_laptop() {
  command -v omarchy-hw-laptop >/dev/null 2>&1 && omarchy-hw-laptop >/dev/null 2>&1
}

require_laptop() {
  if ! command -v omarchy-hw-laptop >/dev/null 2>&1; then
    echo "homelab: omarchy-hw-laptop not found. This expects an Omarchy laptop." >&2
    exit 1
  fi
  if ! is_laptop; then
    echo "homelab: no laptop lid detected. HomeLab mode is for laptops." >&2
    exit 1
  fi
}

mode_name() {
  if [[ -f $mode_flag ]]; then echo "HomeLab"; else echo "Laptop"; fi
}

notify() {
  if [[ -n ${WAYLAND_DISPLAY:-} ]] && command -v notify-send >/dev/null 2>&1; then
    timeout 2 notify-send -a "HomeLab" -i "computer" "$1" "$2" >/dev/null 2>&1 || true
  fi
}

sc() {
  timeout 20 systemctl --user "$@"
}

inhibitor_held() {
  local pid

  pid=$(timeout 2 systemctl --user show -p MainPID --value "$inhibit_unit" 2>/dev/null || true)
  [[ $pid =~ ^[1-9][0-9]*$ ]] || return 1

  if timeout 2 systemd-inhibit --list --json=short --no-pager 2>/dev/null |
    jq -e --argjson pid "$pid" \
      'any(.[]; .pid == $pid and ((.what | split(":")) | index("handle-lid-switch")))' >/dev/null 2>&1; then
    return 0
  fi

  # Older systemd without --json: match the distinctive who string.
  timeout 2 systemd-inhibit --list --no-pager 2>/dev/null |
    grep -q '^HomeLab[[:space:]]'
}

hypr() {
  local sig

  if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] &&
    HYPRLAND_INSTANCE_SIGNATURE=$HYPRLAND_INSTANCE_SIGNATURE timeout 2 hyprctl "$@" 2>/dev/null; then
    return 0
  fi

  for sig in "${XDG_RUNTIME_DIR:-/run/user/$UID}"/hypr/*; do
    [[ -S $sig/.socket.sock ]] || continue
    HYPRLAND_INSTANCE_SIGNATURE=${sig##*/} timeout 2 hyprctl "$@" 2>/dev/null && return 0
  done

  return 1
}

valid_monitor() {
  [[ $1 =~ ^[A-Za-z0-9._-]+$ ]]
}

take_lock() {
  if ! command -v flock >/dev/null 2>&1; then
    echo "warning: flock not found; mode changes are not serialized." >&2
    return 0
  fi

  if ! exec 9>"$lock_file"; then
    echo "homelab: could not open $lock_file for locking." >&2
    exit 1
  fi
  if ! flock -n 9; then
    echo "homelab: another mode change is already running." >&2
    exit 1
  fi
}

start_watcher() {
  if ! sc start "$lid_unit" >/dev/null 2>&1; then
    return 1
  fi
  sc is-active --quiet "$lid_unit"
}

restore_panel() {
  [[ -f $blanked_flag ]] || return 0

  local watcher
  watcher=$(command -v homelab-lid-watch 2>/dev/null || true)
  if [[ -z $watcher ]]; then
    watcher="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/homelab-lid-watch"
  fi

  if [[ -x $watcher ]]; then
    "$watcher" --restore
    return $?
  fi
  return 1
}

announce_on() {
  if lid_closed; then
    echo "HomeLab mode on. The lid is closed: keeping the machine running."
    notify "HomeLab mode" "Lid closed; machine keeps running."
  else
    echo "HomeLab mode on. Closing the lid blanks the display but does not suspend."
    notify "HomeLab mode" "Closing the lid will no longer suspend."
  fi
}

enable_homelab() {
  local tries=0 held=0

  if ! : >"$mode_flag"; then
    echo "HomeLab mode was not enabled: could not write $mode_flag." >&2
    return 1
  fi

  # The inhibitor is the guarantee; the lid watcher only blanks the panel.
  sc reset-failed "$inhibit_unit" >/dev/null 2>&1 || true
  if ! sc start "$inhibit_unit" >/dev/null 2>&1; then
    sc stop "$lid_unit" >/dev/null 2>&1 || true
    sc stop "$inhibit_unit" >/dev/null 2>&1 || true
    restore_panel
    rm -f "$mode_flag"
    echo "HomeLab mode was not enabled: the lid inhibitor did not start." >&2
    sc status "$inhibit_unit" --no-pager 2>&1 | tail -n 20 >&2
    notify "HomeLab mode failed" "The lid inhibitor did not start."
    return 1
  fi

  # Type=simple reports the unit started before systemd-inhibit has acquired
  # the logind lock. Wait for the inhibitor to appear in the list; a running
  # unit without a held lock is the one failure the bar cannot see.
  while (( tries < 20 )); do
    if sc is-active --quiet "$inhibit_unit" && inhibitor_held; then
      held=1
      break
    fi
    tries=$((tries + 1))
    sleep 0.1
  done

  if (( !held )); then
    sc stop "$lid_unit" >/dev/null 2>&1 || true
    sc stop "$inhibit_unit" >/dev/null 2>&1 || true
    restore_panel
    rm -f "$mode_flag"
    echo "HomeLab mode was not enabled: no lid inhibitor is held." >&2
    notify "HomeLab mode failed" "No lid inhibitor is held."
    return 1
  fi

  if ! start_watcher; then
    echo "warning: the lid inhibitor is active, but the panel watcher did not start." >&2
    echo "         The machine will keep running; the internal panel may stay on." >&2
  fi

  if ! sc enable "$inhibit_unit" "$lid_unit" >/dev/null 2>&1; then
    echo "warning: could not enable the units for boot; this mode will not survive a reboot." >&2
  fi

  return 0
}

disable_homelab() {
  local closed=0
  lid_closed && closed=1

  rm -f "$mode_flag"

  # Stop the watcher first. Its ExecStopPost restores DPMS while Hyprland is
  # still alive, and its stop ordering keeps the inhibitor held until then.
  if ! sc stop "$lid_unit" >/dev/null 2>&1; then
    echo "warning: could not stop the lid watcher." >&2
  fi

  if ! restore_panel; then
    echo "warning: could not restore the internal panel; keeping HomeLab mode so it can retry." >&2
    : >"$mode_flag"
    start_watcher || true
    return 1
  fi

  if (( closed )); then
    echo "Releasing the lid inhibitor; a closed lid may suspend immediately."
  fi

  if ! sc stop "$inhibit_unit" >/dev/null 2>&1; then
    echo "warning: could not stop the lid inhibitor; restoring HomeLab mode." >&2
    : >"$mode_flag"
    start_watcher || true
    return 1
  fi

  if (( closed )); then
    echo "HomeLab mode off. If the machine stayed awake, run 'systemctl suspend' to suspend now."
  else
    echo "HomeLab mode off. Closing the lid suspends as before."
  fi

  return 0
}

cmd_on() {
  take_lock
  require_laptop
  enable_homelab || exit 1
  announce_on
}

cmd_off() {
  take_lock
  disable_homelab || exit 1
  notify "Laptop mode" "Lid close suspends as usual."
}

cmd_toggle() {
  take_lock

  if [[ -f $mode_flag ]]; then
    disable_homelab || exit 1
    notify "Laptop mode" "Lid close suspends as usual."
  else
    require_laptop
    enable_homelab || exit 1
    announce_on
  fi
}

status() {
  local flag=0 inhibited=0 watcher=0 enabled=0 lid_enabled=0 blanked=0 issues=0 linger
  local internal state blanked_monitor user_name

  [[ -f $mode_flag ]] && flag=1
  sc is-active --quiet "$inhibit_unit" && inhibited=1
  sc is-active --quiet "$lid_unit" && watcher=1
  sc is-enabled --quiet "$inhibit_unit" 2>/dev/null && enabled=1
  sc is-enabled --quiet "$lid_unit" 2>/dev/null && lid_enabled=1
  [[ -f $blanked_flag ]] && blanked=1

  printf 'Mode:             %s\n' "$(mode_name)"

  if ! command -v omarchy-hw-laptop-closed >/dev/null 2>&1; then
    printf 'Lid:              unknown (omarchy-hw-laptop-closed missing)\n'
  elif lid_closed; then
    printf 'Lid:              closed\n'
  else
    printf 'Lid:              open\n'
  fi

  if (( inhibited )); then
    printf 'Lid suspend:      inhibited (machine keeps running)\n'
  else
    printf 'Lid suspend:      enabled (logind suspends)\n'
  fi

  if (( watcher )); then
    printf 'Lid watcher:      active\n'
  else
    printf 'Lid watcher:      inactive\n'
  fi

  internal=$(timeout 3 omarchy-hyprland-monitor-laptop 2>/dev/null || true)
  valid_monitor "$internal" || internal=""
  if [[ -z $internal ]]; then
    printf 'Internal display: not detected\n'
  else
    state=$(hypr monitors all -j 2>/dev/null |
      jq -r --arg m "$internal" '.[] | select(.name == $m) |
        if .disabled then "disabled" else "enabled" end' |
      head -n 1)
    printf 'Internal display: %s (%s)\n' "$internal" "${state:-unknown}"
  fi

  user_name=$(id -un)
  linger=$(timeout 5 loginctl show-user "$user_name" -p Linger --value 2>/dev/null || echo unknown)
  [[ -n $linger ]] || linger=unknown

  if (( flag )) && (( enabled )); then
    if [[ $linger == yes ]]; then
      printf 'At boot:          HomeLab (persistent, linger: yes)\n'
    else
      printf 'At boot:          HomeLab after login (linger: %s)\n' "$linger"
    fi
  elif (( flag )); then
    printf 'At boot:          HomeLab flag set, but the unit is not enabled\n'
  else
    printf 'At boot:          Laptop (default)\n'
  fi

  if (( blanked )); then
    blanked_monitor=""
    [[ -r $blanked_flag ]] && blanked_monitor=$(<"$blanked_flag")
    if valid_monitor "$blanked_monitor"; then
      printf 'Panel blanked:    yes (%s; restored when the lid opens)\n' "$blanked_monitor"
    else
      printf 'Panel blanked:    yes (restored when the lid opens)\n'
    fi
  fi

  if (( flag )) && ! (( inhibited )); then
    printf 'Health:           inconsistent: mode flag set, inhibitor inactive\n' >&2
    issues=1
  elif ! (( flag )) && (( inhibited )); then
    printf 'Health:           inconsistent: inhibitor active, mode flag absent\n' >&2
    issues=1
  fi

  if (( flag )) && ! (( watcher )); then
    printf 'Health:           warning: lid watcher inactive; the panel may stay on\n' >&2
  fi
  if (( flag )) && ! (( lid_enabled )); then
    printf 'Health:           warning: lid watcher unit is not enabled for graphical sessions\n' >&2
  fi
  if (( blanked )) && ! (( flag )); then
    printf 'Health:           warning: panel blanked without HomeLab mode\n' >&2
  fi

  return "$issues"
}

case "${1:-status}" in
  on|homelab|server)
    cmd_on
    ;;
  off|laptop)
    cmd_off
    ;;
  toggle)
    cmd_toggle
    ;;
  status)
    status
    ;;
  -h|--help|help)
    cat <<'EOF'
Usage: homelab [on|off|toggle|status]

  on, homelab   HomeLab mode: keep running with the lid closed
  off, laptop   Laptop mode: suspend on lid close
  toggle        Switch between the two modes
  status        Show the current mode and lid/display state
EOF
    ;;
  *)
    cat <<'EOF'
Usage: homelab [on|off|toggle|status]

  on, homelab   HomeLab mode: keep running with the lid closed
  off, laptop   Laptop mode: suspend on lid close
  toggle        Switch between the two modes
  status        Show the current mode and lid/display state
EOF
    exit 1
    ;;
esac
