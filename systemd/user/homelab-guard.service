[Unit]
Description=HomeLab mode: safety guard for battery and temperature
ConditionPathExists=%S/homelab/enabled
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=oneshot
SyslogIdentifier=homelab-guard
StateDirectory=homelab
StateDirectoryMode=0700
UMask=0077
ExecStart=%h/.local/bin/homelab guard-check
TimeoutStartSec=60
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%S/homelab
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_UNIX
