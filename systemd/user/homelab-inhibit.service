[Unit]
Description=HomeLab mode: keep the machine running when the lid is closed
Documentation=man:systemd-inhibit(1)
ConditionPathExists=%S/homelab/enabled
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple
SyslogIdentifier=homelab-inhibit
ExecStart=/usr/bin/systemd-inhibit --no-ask-password --what=handle-lid-switch --who=HomeLab --why="HomeLab mode: keep the machine running with the lid closed" --mode=block /usr/bin/sleep infinity
Restart=always
RestartSec=2
TimeoutStopSec=5
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=default.target
