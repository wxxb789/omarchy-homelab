[Unit]
Description=HomeLab mode: turn off when the deadline passes
ConditionPathExists=%S/homelab/enabled
ConditionPathExists=%S/homelab/deadline
StartLimitIntervalSec=30
StartLimitBurst=3

[Service]
Type=simple
SyslogIdentifier=homelab-deadline
StateDirectory=homelab
StateDirectoryMode=0700
UMask=0077
ExecStart=%h/.local/bin/homelab-deadline
Restart=no
TimeoutStopSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%S/homelab
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=default.target
